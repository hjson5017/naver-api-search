# ==========================================
# 1. 환경 변수 및 보안/민감 정보 (Security & Secret Credentials)
# ==========================================
.env
.env.*
!.env.example
.streamlit/secrets.toml
!.streamlit/secrets.toml.example
*.pem
*.key

# ==========================================
# 2. 파이썬 가상환경 (Virtual Environments - 숨김폴더)
# ==========================================
.venv/
venv/
env/
ENV/

# ==========================================
# 3. 파이썬 바이트코드 및 캐시 (Python Cache Files)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ==========================================
# 4. 개발 툴 / IDE 설정 (Editor & IDE Settings - 숨김폴더)
# ==========================================
.vscode/
.idea/
.project
.pydevproject
.settings/

# ==========================================
# 5. 운영체제(OS) 자동 생성 및 숨김 파일 (OS Generated Files)
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ==========================================
# 6. 로그 및 임시 파일 (Logs & Temporary Files)
# ==========================================
*.log
*.tmp
*.bak
