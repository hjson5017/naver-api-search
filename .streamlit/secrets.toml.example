# Streamlit Community Cloud (App Settings -> Secrets) 설정 예시 파일
# 실제 배포 시에는 Streamlit Cloud 관리자 콘솔의 Secrets 메뉴에 아래 내용을 입력하세요.

NAVER_CLIENT_ID = "your_client_id_here"
NAVER_CLIENT_SECRET = "your_client_secret_here"

# (선택) NCP 호환 키 명칭
NCP_CLIENT_ID = "your_client_id_here"
NCP_CLIENT_SECRET = "your_client_secret_here"
